# =============================================================
# Configuração de site (obrigatório em produção)
# =============================================================
# URL canónica do site, sem barra final.
# Usada para: canonical/OG/Twitter, sitemap.xml, robots.txt, JSON-LD, redirects.
# Em dev pode ficar vazia (default https://www.drserracruz.com.br).
VITE_SITE_URL=https://www.drserracruz.com.br

# =============================================================
# Google Places — selo de estrelas + total de avaliações (Testimonials)
# =============================================================
# A chamada é feita no servidor (api/google-reviews); chaves só com restrição
# "sites HTTP" falham na função serverless — use restrição por IP ou sem restrição em dev.
# Copie para .env ou .env.local na raiz e preencha (não commite valores reais).
GOOGLE_PLACES_API_KEY=
GOOGLE_PLACE_ID=

# =============================================================
# Opcional
# =============================================================
GEMINI_API_KEY=
