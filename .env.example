# Google Places — apenas para o selo de estrelas + total de avaliações (Testimonials).
# Copie para .env ou .env.local na raiz e preencha (não commite valores reais).
# A chamada é feita no servidor: chaves só com restrição "sites HTTP" falham — use IP ou sem restrição em dev.
GOOGLE_PLACES_API_KEY=
GOOGLE_PLACE_ID=

# Opcional
GEMINI_API_KEY=
